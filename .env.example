# ==============================================================================
# Community AI Bot Configuration (.env)
# 100% Server Owner Sovereign & 0$ Serverless
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Gateway & Model Settings
# Get API Key & check live models/pricing: https://b-lost.com/pricing
# (New users claim $10 free starter credits + 100% first deposit match)
# ------------------------------------------------------------------------------
BLOST_BASE_URL=https://b-lost.com/v1
BLOST_API_KEY=sk-your-b-lost-api-key-here

# 2026 Recommended Models (Copy & Paste):
# - gemini-3.8-flash  : Ultra-low latency (<150ms), highly economical (Casual chat / Q&A)
# - deepseek-v4-pro   : 2026 flagship open-source reasoning (Great for tech communities)
# - claude-sonnet-5   : Premier coding & architecture powerhouse (For elite dev servers)
# - gpt-6-astra       : OpenAI 2026 latest full-capability flagship
#
# 📋 Full Models & Real-time Pricing Catalog: https://b-lost.com/pricing
# 💡 [Key Grouping Note / 分組說明]:
# When generating an API Key at https://b-lost.com, ensure your key's group includes
# your selected model (e.g. selecting "Auto" or checking the appropriate vendor group).
DEFAULT_MODEL=gemini-3.8-flash
MAX_TOKENS=800
TEMPERATURE=0.3

# ------------------------------------------------------------------------------
# 2. Bot Identity & Customization (DIY)
# ------------------------------------------------------------------------------
# Display name of your bot
BOT_NAME="DevClub Assistant"

# System Prompt / Personality
SYSTEM_PROMPT="You are a sharp, production-ready coding assistant in our developer community. Deliver concise, clean code snippets and syntax fixes. Keep explanations under 200 words unless full architecture is requested."

# Community Rules (Optional - bot will reference these to answer rule queries)
COMMUNITY_RULES="1. Be respectful to fellow developers.\n2. Do not post spam or unsolicited promotional links.\n3. Keep discussions in relevant channels."

# Community Knowledge Base & FAQ (Optional - bot answers questions about your project/community)
COMMUNITY_KNOWLEDGE="Official Website: https://your-community.com\nGitHub Repo: https://github.com/your-org/repo\nDocs: https://docs.your-community.com\nTech Stack: Next.js, TypeScript, TailwindCSS."

# ------------------------------------------------------------------------------
# 3. Footer / Attribution Settings
# ------------------------------------------------------------------------------
# Set to false if you want zero footer attribution
ENABLE_FOOTER=true

# Custom footer text (defaults to Powered by B-Lost Gateway)
CUSTOM_FOOTER="⚡ Powered by [B-Lost Gateway](https://b-lost.com)"

# ------------------------------------------------------------------------------
# 4. Discord Bot Settings (Required for Discord Slash Commands)
# Get these from https://discord.com/developers/applications
# ------------------------------------------------------------------------------
DISCORD_APP_ID=your_discord_app_id
DISCORD_PUBLIC_KEY=your_discord_public_key
DISCORD_BOT_TOKEN=your_discord_bot_token

# ------------------------------------------------------------------------------
# 5. Telegram Bot Settings (Optional, leave blank if not using Telegram)
# Get token from @BotFather on Telegram
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ------------------------------------------------------------------------------
# 6. Local Server Port (for standalone / Docker mode)
# ------------------------------------------------------------------------------
PORT=3000
