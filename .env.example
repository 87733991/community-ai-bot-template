# ==============================================================================
# B-Lost 1-Click Community AI Bot Configuration
# ==============================================================================

# 1. B-Lost Gateway Settings (Get free $1 credits at https://b-lost.com)
BLOST_BASE_URL=https://b-lost.com/v1
BLOST_API_KEY=sk-your-b-lost-api-key-here
DEFAULT_MODEL=gemini-2.5-flash
MAX_TOKENS=800

# 2. Discord Bot Settings (Required for Discord Slash Commands)
# Get these from https://discord.com/developers/applications
DISCORD_APP_ID=your_discord_app_id
DISCORD_PUBLIC_KEY=your_discord_public_key
DISCORD_BOT_TOKEN=your_discord_bot_token

# 3. Telegram Bot Settings (Optional, leave blank if not using Telegram)
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 4. Assistant Persona / System Prompt
SYSTEM_PROMPT="You are a sharp, production-ready coding assistant in a developer community. Deliver concise, clean code snippets and syntax fixes. Keep explanations under 200 words unless full architecture is requested."

# 5. Local Server Port (for standalone / Docker mode)
PORT=3000
